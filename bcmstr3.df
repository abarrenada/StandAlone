  MANDATORY

ADD FIELD "arch-bcp-pkg-ind" OF "arch-bc-pallet" AS integer 
  FORMAT "9"
  INITIAL ?
  LABEL "PI"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "PI"
  ORDER 50
  MANDATORY

ADD FIELD "arch-bcp-status" OF "arch-bc-pallet" AS character 
  FORMAT "x(1)"
  INITIAL ""
  LABEL "St"
  POSITION 7
  MAX-WIDTH 2
  COLUMN-LABEL "St"
  ORDER 60

ADD FIELD "arch-bcp-crte-date" OF "arch-bc-pallet" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Created"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Created"
  ORDER 70
  MANDATORY

ADD FIELD "arch-bcp-updt-date" OF "arch-bc-pallet" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Updated"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "Updated"
  ORDER 80

ADD FIELD "arch-bcp-updt-by" OF "arch-bc-pallet" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "UpdtBy"
  POSITION 10
  MAX-WIDTH 16
  COLUMN-LABEL "UpdtBy"
  ORDER 90

ADD FIELD "arch-bcp-create-user" OF "arch-bc-pallet" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Create User"
  POSITION 11
  MAX-WIDTH 20
  COLUMN-LABEL "CreateUser"
  ORDER 100

ADD INDEX "prim" ON "arch-bc-pallet" 
  AREA "index128"
  UNIQUE
  PRIMARY
  INDEX-FIELD "arch-bcp-company" ASCENDING 
  INDEX-FIELD "arch-bcp-item" ASCENDING 
  INDEX-FIELD "arch-bcp-lis-qty" ASCENDING 
  INDEX-FIELD "arch-bcp-no-boxes" ASCENDING 

ADD INDEX "seckey" ON "arch-bc-pallet" 
  AREA "index128"
  UNIQUE
  INDEX-FIELD "arch-bcp-company" ASCENDING 
  INDEX-FIELD "arch-bcp-item" ASCENDING 
  INDEX-FIELD "arch-bcp-lis-qty" ASCENDING 
  INDEX-FIELD "arch-bcp-pkg-ind" ASCENDING 

ADD TABLE "architemdet"
  AREA "itemdet64"
  LABEL "Archive Item Detail table"
  DESCRIPTION "This table contains archive detail barcode information like carton
UPC, LIS qty, Sales qty, Iref #, package indicator, customer 
character, UM, grade, SkinPack card printer and grade.
"
  DUMP-NAME "architemdet"

ADD FIELD "aid-item-nbr" OF "architemdet" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item #"
  POSITION 2
  MAX-WIDTH 30
  COLUMN-LABEL "Item #"
  ORDER 10
  MANDATORY

ADD FIELD "aid-extract" OF "architemdet" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "Ext"
  POSITION 3
  MAX-WIDTH 2
  COLUMN-LABEL "Ext"
  ORDER 180

ADD FIELD "aid-sales-um" OF "architemdet" AS character 
  FORMAT "x(04)"
  INITIAL ""
  LABEL "SlsUM"
  POSITION 4
  MAX-WIDTH 8
  COLUMN-LABEL "SlsUM"
  ORDER 40

ADD FIELD "aid-sales-qty" OF "architemdet" AS decimal 
  FORMAT "zzzzzz9.99"
  INITIAL "0"
  LABEL "SlsQty"
  POSITION 5
  MAX-WIDTH 17
  COLUMN-LABEL "SlsQty"
  DECIMALS 2
  ORDER 50

ADD FIELD "aid-pkg-wgt" OF "architemdet" AS decimal 
  FORMAT "zzzzzz9.99"
  INITIAL "0"
  LABEL "PkgWgt"
  POSITION 6
  MAX-WIDTH 17
  COLUMN-LABEL "PkgWgt"
  DECIMALS 2
  ORDER 60

ADD FIELD "aid-ctn-num-sys" OF "architemdet" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "CtnNumSys"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "CtnNumSys"
  ORDER 70

ADD FIELD "aid-ctn-mfg" OF "architemdet" AS integer 
  FORMAT "99999"
  INITIAL "0"
  LABEL "CtnMfg"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "CtnMfg"
  ORDER 80

ADD FIELD "aid-ctn-prd" OF "architemdet" AS integer 
  FORMAT "99999"
  INITIAL "0"
  LABEL "CtnPrd"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "CtnPrd"
  ORDER 90

ADD FIELD "aid-ctn-chkdgt" OF "architemdet" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "CtnCkDgt"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "CtnCdDgt"
  ORDER 100

ADD FIELD "aid-cust-char" OF "architemdet" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "CustChar"
  POSITION 11
  MAX-WIDTH 2
  COLUMN-LABEL "CustChar"
  ORDER 110

ADD FIELD "aid-lis-qty" OF "architemdet" AS integer 
  FORMAT "zzzzzz9"
  INITIAL "0"
  LABEL "LIS Qty"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "LIS Qty"
  ORDER 20
  MANDATORY

ADD FIELD "aid-iref" OF "architemdet" AS integer 
  FORMAT "999999"
  INITIAL "0"
  LABEL "Iref#"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "Iref#"
  ORDER 130
  MANDATORY

ADD FIELD "aid-create-dte" OF "architemdet" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "CreateDt"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "CreateDt"
  ORDER 140
  MANDATORY

