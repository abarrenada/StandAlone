ADD TABLE "ItemProduced"
  AREA "data64"
  DUMP-NAME "itemprod"

ADD FIELD "ip-IRef" OF "ItemProduced" AS integer 
  FORMAT "999999"
  INITIAL "0"
  LABEL "Iref#"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Iref#"
  ORDER 130
  MANDATORY

ADD FIELD "ip-DateProduced" OF "ItemProduced" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "DateProd"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "DateProd"
  HELP "Enter date item produced."
  ORDER 140

ADD FIELD "ip-RecSn" OF "ItemProduced" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  POSITION 4
  MAX-WIDTH 4
  HELP "Receiving record serial number to use next."
  ORDER 10

ADD FIELD "ip-TrnDate" OF "ItemProduced" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "TrnDate"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "TrnDate"
  HELP "Date record created."
  ORDER 160

ADD FIELD "ip-TrnTime" OF "ItemProduced" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "TrnTime"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "TrnTime"
  HELP "Time record created"
  ORDER 170

ADD FIELD "ip-RecType" OF "ItemProduced" AS character 
  DESCRIPTION "Flag indicates type of record..M=manual, A=auto, Pallet?"
  FORMAT "x"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 2
  ORDER 250

ADD FIELD "ip-Shift" OF "ItemProduced" AS integer 
  FORMAT "9"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 4
  HELP "Shift that item was produced on."
  ORDER 158

ADD FIELD "ip-comment" OF "ItemProduced" AS character 
  FORMAT "x(35)"
  INITIAL ""
  LABEL "Comment"
  POSITION 9
  MAX-WIDTH 70
  COLUMN-LABEL "Comment"
  HELP "Comment such as reason for subtract or add from/to production."
  ORDER 200

ADD FIELD "ip-TrnUser" OF "ItemProduced" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "User"
  POSITION 10
  MAX-WIDTH 16
  COLUMN-LABEL "User"
  HELP "User login that created the record."
  ORDER 210

ADD FIELD "ip-Shade" OF "ItemProduced" AS integer 
  FORMAT "9999"
  INITIAL "0"
  LABEL "Shade"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "Shade"
  HELP "Shade of this produced item."
  ORDER 220

ADD FIELD "ip-Line" OF "ItemProduced" AS integer 
  DESCRIPTION "Unique identifier for a sorter/production line."
  FORMAT "99"
  INITIAL "0"
  LABEL "Li"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Li"
  HELP "Production/sorter line number."
  ORDER 157

ADD FIELD "ip-Size" OF "ItemProduced" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "Size"
  POSITION 13
  MAX-WIDTH 2
  COLUMN-LABEL "Size"
  HELP "Size of this produced item."
  ORDER 230

ADD FIELD "ip-LisQty" OF "ItemProduced" AS integer 
  FORMAT "zzzzzz9"
  INITIAL "0"
  LABEL "LIS Qty"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "LIS Qty"
  ORDER 20
  MANDATORY

ADD FIELD "ip-NumCtns" OF "ItemProduced" AS integer 
  FORMAT "-999"
  INITIAL "0"
  LABEL "Ctns"
  POSITION 15
  MAX-WIDTH 4
  HELP "Number of Boxes produced."
  ORDER 240

ADD FIELD "ip-OrderNum" OF "ItemProduced" AS character 
  FORMAT "x(11)"
  INITIAL ""
  POSITION 16
  MAX-WIDTH 22
  ORDER 260

ADD FIELD "ip-Location" OF "ItemProduced" AS character 
  FORMAT "x(6)"
  INITIAL ""
  POSITION 17
  MAX-WIDTH 12
  ORDER 270

ADD FIELD "ip-item-nbr" OF "ItemProduced" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item #"
  POSITION 18
  MAX-WIDTH 30
  COLUMN-LABEL "Item #"
  ORDER 320
  MANDATORY

ADD FIELD "ip-PartialQty" OF "ItemProduced" AS decimal 
  FORMAT "->>9.99"
  INITIAL "0"
  LABEL "PartialQty"
  POSITION 19
  MAX-WIDTH 17
  COLUMN-LABEL "PartialQty"
  HELP "Partial Qty produced."
  DECIMALS 2
  ORDER 330

ADD FIELD "ip-recdup-seq" OF "ItemProduced" AS integer 
  DESCRIPTION "Record Dup Seq"
  FORMAT "99"
  INITIAL "0"
  LABEL "DSeq"
  POSITION 20
  MAX-WIDTH 4
  COLUMN-LABEL "DSeq"
  ORDER 340
  MANDATORY

ADD FIELD "ip-plant" OF "ItemProduced" AS integer 
  DESCRIPTION "Plant"
  FORMAT "999"
  INITIAL "0"
  LABEL "Plt"
  POSITION 21
  MAX-WIDTH 4
  COLUMN-LABEL "Plt"
  ORDER 350
  MANDATORY

ADD INDEX "Prim" ON "ItemProduced" 
  AREA "index64"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ip-plant" ASCENDING 
  INDEX-FIELD "ip-RecSn" ASCENDING 
  INDEX-FIELD "ip-recdup-seq" ASCENDING 

