  MAX-WIDTH 20
  COLUMN-LABEL "UpdateUser"
  ORDER 230

ADD FIELD "aid-company" OF "architemdet" AS character 
  FORMAT "x(2)"
  INITIAL "DT"
  LABEL "Company"
  POSITION 25
  MAX-WIDTH 2
  COLUMN-LABEL "Company"
  ORDER 240

ADD FIELD "aid-status" OF "architemdet" AS character 
  FORMAT "x(1)"
  INITIAL ""
  LABEL "Status"
  POSITION 26
  MAX-WIDTH 1
  COLUMN-LABEL "Status"
  ORDER 250

ADD INDEX "prim" ON "architemdet" 
  AREA "itemdet_Index64"
  UNIQUE
  PRIMARY
  INDEX-FIELD "aid-item-nbr" ASCENDING 
  INDEX-FIELD "aid-lis-qty" ASCENDING 

ADD INDEX "carton" ON "architemdet" 
  AREA "itemdet_Index64"
  UNIQUE
  INDEX-FIELD "aid-ctn-num-sys" ASCENDING 
  INDEX-FIELD "aid-ctn-mfg" ASCENDING 
  INDEX-FIELD "aid-ctn-prd" ASCENDING 
  INDEX-FIELD "aid-ctn-chkdgt" ASCENDING 

ADD INDEX "iref" ON "architemdet" 
  AREA "itemdet_Index64"
  UNIQUE
  INDEX-FIELD "aid-iref" ASCENDING 

ADD INDEX "item" ON "architemdet" 
  AREA "itemdet_Index64"
  INDEX-FIELD "aid-item-nbr" ASCENDING ABBREVIATED 

ADD TABLE "architemhdr"
  AREA "itemhdr32"
  LABEL "Item Header table"
  DESCRIPTION "This table contains all the common archive header barcode information
like single tile UPC, color, shape and series descriptions.
"
  DUMP-NAME "architemhdr"

ADD FIELD "aih-item-nbr" OF "architemhdr" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item #"
  POSITION 2
  MAX-WIDTH 30
  COLUMN-LABEL "Item #"
  ORDER 10
  MANDATORY

ADD FIELD "aih-plant" OF "architemhdr" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "Plant"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Plant"
  ORDER 120

