ADD FIELD "aid-card-ptr" OF "architemdet" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "Ptr"
  POSITION 18
  MAX-WIDTH 2
  COLUMN-LABEL "Ptr"
  ORDER 30

ADD FIELD "aid-lis-desc" OF "architemdet" AS character 
  FORMAT "x(07)"
  INITIAL ""
