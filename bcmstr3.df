ADD TABLE "defalt"
  AREA "data64"
  DUMP-NAME "defalt"

ADD FIELD "pass-word" OF "defalt" AS character 
  FORMAT "x(08)"
  INITIAL ""
  LABEL "PassWord"
  POSITION 2
  MAX-WIDTH 16
  COLUMN-LABEL "PassWord"
  ORDER 90

ADD FIELD "shade" OF "defalt" AS integer 
  DESCRIPTION "Default shade produced in this plant."
  FORMAT "9999"
  INITIAL "0"
  LABEL "Shade"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Shade"
  HELP "Default shade produced in this plant."
  ORDER 10

ADD FIELD "min-line" OF "defalt" AS integer 
  DESCRIPTION "Minimum Production line number for this plant."
  FORMAT "99"
  INITIAL "0"
  LABEL "Min"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Min"
  HELP "Minimum production line number for this plant."
  ORDER 50

ADD FIELD "max-line" OF "defalt" AS integer 
  DESCRIPTION "Maximum production line # for this plant."
  FORMAT "99"
  INITIAL "0"
  LABEL "Max"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Max"
  HELP "Maximum production line # for this plant."
  ORDER 60

ADD FIELD "mfg-desc" OF "defalt" AS character 
  DESCRIPTION "Plant Desc for Plant"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Mfg Desc"
  POSITION 6
  MAX-WIDTH 24
  COLUMN-LABEL "Mfg Desc"
  HELP "Plant Desc for Plant"
  ORDER 70

ADD FIELD "plant" OF "defalt" AS integer 
  DESCRIPTION "Default plant that appears as human readable on the label"
  FORMAT "999"
  INITIAL "0"
  LABEL "Plant"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Plant"
  VALEXP "plant > 0"
  VALMSG "Plant must be setup in the valid plants table"
  HELP "Plant ID, must be setup in the valid plants table."
  ORDER 30
  MANDATORY

ADD FIELD "company" OF "defalt" AS character 
  DESCRIPTION "Company ID (DTil or MK)"
  FORMAT "x(02)"
  INITIAL ""
  LABEL "Co #"
  POSITION 8
  MAX-WIDTH 2
  COLUMN-LABEL "Co #"
  HELP "Company ID (DT or MK)"
  ORDER 80
  MANDATORY

ADD FIELD "size" OF "defalt" AS character 
  DESCRIPTION "Default size/calbr made in this plant"
  FORMAT "x(01)"
  INITIAL ""
  LABEL "Size"
  POSITION 9
  MAX-WIDTH 2
  COLUMN-LABEL "Size"
  HELP "Default size made in this plant."
  ORDER 20

ADD FIELD "updt-plant-ok" OF "defalt" AS logical 
  DESCRIPTION "Allows the Plant field to be modified when printing labels"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Update Plant OK"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "Update Plant OK"
  HELP "Yes allows the plant field to be modified for lookups & prints"
  ORDER 40

ADD FIELD "RecLoc" OF "defalt" AS character 
  DESCRIPTION "Default AutoReceiving Location"
  FORMAT "x(6)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 12
  HELP "Default AutoReceiving Location"
  ORDER 100

ADD FIELD "RequireOrder" OF "defalt" AS logical 
  DESCRIPTION "Yes for Order# is required to be entered during AutoReceiving"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 12
  MAX-WIDTH 1
  HELP "Yes=Order # is required to be entered during AutoReceiving"
  ORDER 110

ADD FIELD "KeyRcvEntry" OF "defalt" AS logical 
  DESCRIPTION "No for Must scan barcode, Yes for allow entry of Item or Scan BC"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 13
  MAX-WIDTH 1
  HELP "No=Must scan barcode.Yes=Allow entry of Item or Scan of barcode"
  ORDER 120

ADD FIELD "Allow-Partials" OF "defalt" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Partials?"
  POSITION 14
  MAX-WIDTH 1
  COLUMN-LABEL "Partials?"
  VALMSG "Allow partial entries for AutoReceiving"
  HELP "If yes, allow partial entry for AutoReceiving. If no, will not."
  ORDER 130
  MANDATORY

ADD FIELD "Days-Back" OF "defalt" AS integer 
  DESCRIPTION "i.e. 1 = allow to go back 1 day form current date"
  FORMAT "99"
  INITIAL "1"
  LABEL "DaysBack"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "DaysBack"
  HELP "# of days back to allow AutoReceiving for"
  ORDER 140
  MANDATORY

