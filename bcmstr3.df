  FORMAT "x(01)"
  INITIAL ""
  LABEL "Ext"
  POSITION 4
  MAX-WIDTH 2
  COLUMN-LABEL "Ext"
  ORDER 130

ADD FIELD "aih-product-type" OF "architemhdr" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "ProductType"
  POSITION 5
  MAX-WIDTH 2
  COLUMN-LABEL "ProductType"
