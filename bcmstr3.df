  DESCRIPTION "Flag to denote if Plant also has RDC attached and using WMS system"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "WMS Plant"
  POSITION 16
  MAX-WIDTH 1
  COLUMN-LABEL "WMS Plant"
  HELP "Yes to denote if Plant also has RDC/WMS system"
  ORDER 150

