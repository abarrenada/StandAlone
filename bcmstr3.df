  FORMAT "yes/no"
  INITIAL "no"
  LABEL "DoesMexLbl"
  POSITION 19
  MAX-WIDTH 1
  COLUMN-LABEL "DoesMexLbl"
  HELP "Yes for Plant makes Mexico Only Labels"
  ORDER 180

ADD FIELD "HasHandScan" OF "defalt" AS logical 
  DESCRIPTION "Plant has Hand Scanners"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "HasHandScan"
  POSITION 20
  MAX-WIDTH 1
  COLUMN-LABEL "HasHandScan"
  HELP "Yes if Plant has Hand Scanners on each terminal"
  ORDER 190

ADD FIELD "Plant-type" OF "defalt" AS character 
  DESCRIPTION "Plant type "
  FORMAT "x(04)"
  INITIAL "A"
  LABEL "PltTyp"
  POSITION 21
  MAX-WIDTH 2
