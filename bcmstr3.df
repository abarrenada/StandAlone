  ORDER 140

ADD FIELD "aih-sgl-num-sys" OF "architemhdr" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "SglNumSys"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "SglNumSys"
  ORDER 60

