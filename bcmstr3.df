  LABEL "Create User"
  POSITION 23
  MAX-WIDTH 20
  COLUMN-LABEL "CreateUser"
  ORDER 220

ADD FIELD "aid-update-user" OF "architemdet" AS character 
  FORMAT "x(20)"
