ADD TABLE "skushades"
  AREA "data64"
  DUMP-NAME "skushades"

ADD FIELD "ss-company" OF "skushades" AS character 
  DESCRIPTION "Company ID (DTil or MK)"
  FORMAT "x(02)"
  INITIAL ""
  LABEL "Co #"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Co #"
  HELP "Company ID (DT or MK)"
  ORDER 10
  MANDATORY

ADD FIELD "ss-plant" OF "skushades" AS integer 
  DESCRIPTION "Default plant"
  FORMAT "999"
  INITIAL "0"
  LABEL "Plant"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Plant"
  VALEXP "ss-plant > 0"
  VALMSG "Plant must be setup in the valid plants table"
  HELP "Plant ID, must be setup in the valid plants table."
  ORDER 20
  MANDATORY

ADD FIELD "ss-item-nbr" OF "skushades" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item #"
  POSITION 4
  MAX-WIDTH 30
  COLUMN-LABEL "Item #"
  ORDER 30
  MANDATORY

ADD FIELD "ss-match-shade" OF "skushades" AS integer 
  FORMAT "999"
  INITIAL "0"
  LABEL "MatchShade"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "MatchShade"
  VALEXP "ss-match-shade > 0"
  VALMSG "MatchShade must be greater than 0"
  HELP "Shade to match for rework item"
  ORDER 40

ADD FIELD "ss-label-shade" OF "skushades" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 6
  MAX-WIDTH 1
  HELP "Whether to use this shade number on the box label"
  ORDER 50

ADD FIELD "ss-create-date" OF "skushades" AS date 
  DESCRIPTION "Create Date"
