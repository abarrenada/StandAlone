  DESCRIPTION "Print Whse Pallet Label"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "WhsePalLbl"
  POSITION 17
  MAX-WIDTH 1
  COLUMN-LABEL "WhsePalLbl"
  HELP "Yes to Print Whse Pallet Label"
  ORDER 160

