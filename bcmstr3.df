ADD TABLE "production"
  AREA "data32"
  DESCRIPTION "Production Data"
  DUMP-NAME "producti"

ADD FIELD "pd-RecSn" OF "production" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  HELP "Receiving record serial number to use next."
  ORDER 10

ADD FIELD "pd-comment" OF "production" AS character 
  FORMAT "x(35)"
  INITIAL ""
  LABEL "Comment"
  POSITION 3
  MAX-WIDTH 70
  COLUMN-LABEL "Comment"
  HELP "Comment such as reason for subtract or add from/to production."
  ORDER 200

ADD FIELD "pd-DateProduced" OF "production" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "DateProd"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "DateProd"
  HELP "Enter date item produced."
  ORDER 140

ADD FIELD "pd-IRef" OF "production" AS integer 
  FORMAT "999999"
  INITIAL "0"
  LABEL "Iref#"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Iref#"
  ORDER 130
  MANDATORY

ADD FIELD "pd-item-nbr" OF "production" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item #"
  POSITION 6
  MAX-WIDTH 30
  COLUMN-LABEL "Item #"
  ORDER 320
  MANDATORY

ADD FIELD "pd-Line" OF "production" AS integer 
  DESCRIPTION "Unique identifier for a sorter/production line."
  FORMAT "99"
  INITIAL "0"
  LABEL "Li"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Li"
  HELP "Production/sorter line number."
  ORDER 157

ADD FIELD "pd-LisQty" OF "production" AS integer 
  FORMAT "zzzzzz9"
  INITIAL "0"
  LABEL "LIS Qty"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "LIS Qty"
  ORDER 20
  MANDATORY

ADD FIELD "pd-Location" OF "production" AS character 
  FORMAT "x(6)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 12
  ORDER 270

ADD FIELD "pd-NumCtns" OF "production" AS integer 
  FORMAT "-999"
  INITIAL "0"
  LABEL "Ctns"
  POSITION 10
  MAX-WIDTH 4
  HELP "Number of Boxes produced."
  ORDER 240

ADD FIELD "pd-OrderNum" OF "production" AS character 
  FORMAT "x(11)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 22
  ORDER 260

ADD FIELD "pd-PartialQty" OF "production" AS decimal 
  FORMAT "->>9.99"
  INITIAL "0"
  LABEL "PartialQty"
  POSITION 12
  MAX-WIDTH 17
  COLUMN-LABEL "PartialQty"
  HELP "Partial Qty produced."
  DECIMALS 2
  ORDER 330

ADD FIELD "pd-RecType" OF "production" AS character 
  DESCRIPTION "Flag indicates type of record..M=manual, A=auto, Pallet?"
  FORMAT "x"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 2
  ORDER 250

ADD FIELD "pd-Shade" OF "production" AS integer 
  FORMAT "9999"
  INITIAL "0"
  LABEL "Shade"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "Shade"
  HELP "Shade of this produced item."
  ORDER 220

ADD FIELD "pd-Shift" OF "production" AS integer 
  FORMAT "9"
  INITIAL "0"
  POSITION 15
  MAX-WIDTH 4
  HELP "Shift that item was produced on."
  ORDER 158

ADD FIELD "pd-Size" OF "production" AS character 
  FORMAT "x(01)"
  INITIAL ""
  LABEL "Size"
  POSITION 16
  MAX-WIDTH 2
  COLUMN-LABEL "Size"
  HELP "Size of this produced item."
  ORDER 230

ADD FIELD "pd-TrnDate" OF "production" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "TrnDate"
  POSITION 17
  MAX-WIDTH 4
  COLUMN-LABEL "TrnDate"
  HELP "Date record created."
  ORDER 160

ADD FIELD "pd-TrnTime" OF "production" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "TrnTime"
  POSITION 18
  MAX-WIDTH 16
  COLUMN-LABEL "TrnTime"
  HELP "Time record created"
  ORDER 170

ADD FIELD "pd-TrnUser" OF "production" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "User"
  POSITION 19
  MAX-WIDTH 16
  COLUMN-LABEL "User"
  HELP "User login that created the record."
  ORDER 210

ADD FIELD "pd-pallet-nbr" OF "production" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Pal-Nbr"
  POSITION 20
  MAX-WIDTH 16
  COLUMN-LABEL "Pal-Nbr"
  ORDER 340

ADD INDEX "prim" ON "production" 
  AREA "index32"
  UNIQUE
  PRIMARY
  INDEX-FIELD "pd-RecSn" ASCENDING 

