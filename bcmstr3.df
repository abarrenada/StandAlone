ADD FIELD "arch-bcp-company" OF "arch-bc-pallet" AS character 
  FORMAT "x(2)"
  INITIAL "DT"
  LABEL "Co"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Co"
