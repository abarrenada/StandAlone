ADD FIELD "arch-bcp-item" OF "arch-bc-pallet" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Item"
  POSITION 3
  MAX-WIDTH 30
  COLUMN-LABEL "Item"
  ORDER 20
  MANDATORY

ADD FIELD "arch-bcp-lis-qty" OF "arch-bc-pallet" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "LisQty"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "LisQty"
