ADD TABLE "Serial"
  AREA "data256"
  DUMP-NAME "serial"

ADD FIELD "IpSn" OF "Serial" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  HELP "ItemProduced record serial number"
  ORDER 10

ADD FIELD "CIPSn" OF "Serial" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  HELP "Consolidated record item produced serial number."
  ORDER 20

ADD TABLE "setsato"
  AREA "data128"
  DESCRIPTION "Set Sato heat and speed by termid, lineid, Sato model and
copybook.
"
  DUMP-NAME "setsato"

ADD FIELD "lineid" OF "setsato" AS integer 
  DESCRIPTION "Unique identifier for a sorter/production line."
  FORMAT "99"
  INITIAL "0"
  LABEL "Li"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Li"
  ORDER 20
  MANDATORY

ADD FIELD "termid" OF "setsato" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "TermID"
  POSITION 3
  MAX-WIDTH 30
  COLUMN-LABEL "TermID"
  ORDER 10
  MANDATORY

ADD FIELD "sato-model" OF "setsato" AS character 
  FORMAT "x(08)"
  INITIAL ""
  LABEL "SatoModel"
  POSITION 4
  MAX-WIDTH 16
  COLUMN-LABEL "SatoModel"
  HELP "Must be M-8400 (beige Sato) or M-8400RV (grey Sato)"
  ORDER 30
  MANDATORY

ADD FIELD "copybook" OF "setsato" AS character 
  FORMAT "x(08)"
  INITIAL ""
  LABEL "Copybook"
  POSITION 5
  MAX-WIDTH 16
  COLUMN-LABEL "Copybook"
  HELP "Name of copybook where Sato defaults stored."
  ORDER 40
  MANDATORY

ADD FIELD "heat" OF "setsato" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "Heat"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Heat"
  HELP "Must be 1 (lightest) to 5 (darkest)."
  ORDER 50
  MANDATORY

ADD FIELD "speed" OF "setsato" AS character 
  FORMAT "x(03)"
  INITIAL ""
  LABEL "Speed"
  POSITION 7
  MAX-WIDTH 6
  COLUMN-LABEL "Speed"
  HELP "MustBe CS1 (50mm/s), CS2 (75mm/s), CS3 (100mm/s), CS4 (125mm/s)"
  ORDER 60
  MANDATORY

ADD INDEX "prim" ON "setsato" 
  AREA "index128"
  UNIQUE
  PRIMARY
  INDEX-FIELD "termid" ASCENDING 
  INDEX-FIELD "lineid" ASCENDING 
  INDEX-FIELD "sato-model" ASCENDING 
  INDEX-FIELD "copybook" ASCENDING 

