  MAX-WIDTH 4
  COLUMN-LABEL "SglPrd"
  ORDER 80

ADD FIELD "aih-sgl-chkdgt" OF "architemhdr" AS integer 
  FORMAT "9"
  INITIAL "0"
  LABEL "SglCkDgt"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "SglCkDgt"
  ORDER 90

ADD FIELD "aih-color-desc" OF "architemhdr" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "ColorDesc"
  POSITION 10
  MAX-WIDTH 60
  COLUMN-LABEL "ColorDesc"
  ORDER 20

ADD FIELD "aih-shape-desc" OF "architemhdr" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "ShapeDesc"
  POSITION 11
  MAX-WIDTH 60
  COLUMN-LABEL "ShapeDesc"
  ORDER 30

ADD FIELD "aih-create-dte" OF "architemhdr" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "CreateDt"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "CreateDt"
  ORDER 100
  MANDATORY

ADD FIELD "aih-update-dte" OF "architemhdr" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "LstUpdte"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "LstUpdte"
  ORDER 110

ADD FIELD "aih-series-desc" OF "architemhdr" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "SeriesDesc"
  POSITION 14
