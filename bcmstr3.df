ADD SEQUENCE "slab-seq"
  INITIAL 150000014
  INCREMENT 1
  CYCLE-ON-LIMIT yes
  MIN-VAL 150000014
  MAX-VAL 200000000

ADD TABLE "altname"
  AREA "data256"
  DESCRIPTION "Alternate manufacturer name table ( for name on label )"
  DUMP-NAME "altname"

ADD FIELD "mfg-desc" OF "altname" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Mfg Desc"
  POSITION 2
  MAX-WIDTH 24
  COLUMN-LABEL "Mfg Desc"
  ORDER 10

ADD INDEX "MfgDesc" ON "altname" 
  AREA "index256"
  UNIQUE
  PRIMARY
  INDEX-FIELD "mfg-desc" ASCENDING 

