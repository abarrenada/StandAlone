# symbolic SATO template
# family: F&D Private Label (label-type-code=4) / 1.75x8.38 / automatic (PLC)
# ported field-for-field from c:\Workspace\southalr\dtplb005.i, dispatched from dtplc067.p's
# ih-label-type-code=4 branch when the line's configured include for this size is
# "dtlbl060o.i".
#
# Same simplifications as lt04_default_2x725.sato -- see that file's header (no setsato,
# model-gate skipped [source only supports S86RD/85R here], SAP-gap size fields blank,
# Box Quantity mapped to LisQty, trailing "xxxxxxxxxx" reproduced verbatim).

<STX>
\x1bA
\x1bCS3
\x1b#E2
\x1bA3H0010V0000
\x1b%3
\x1bH315\x1bV0020\x1bL0101\x1bRDA00,P16,P20,{ColorDesc}
\x1bH305\x1bV1050\x1bL0101\x1bRDA00,P16,P16,SKU# {CustomerPartNumber}
\x1bH255\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Box Quantity: {LisQty}
\x1bH220\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Lot Code: {ShadeLotCode}
\x1bH185\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Production Date: {MfgDateCodeShort}
\x1bH265\x1bV1050\x1bD3021300{CartonUpcNumSys}{CartonUpcMfg}{CartonUpcProd}{CartonUpcChkdgt}
\x1bH130\x1bV1035\x1bL0102\x1bS{CartonUpcNumSys}
\x1bH130\x1bV1075\x1bL0102\x1bS{CartonUpcMfg}
\x1bH130\x1bV1162\x1bL0102\x1bS{CartonUpcProd}
\x1bH130\x1bV1245\x1bL0102\x1bS{CartonUpcChkdgt}
\x1bH145\x1bV0020\x1bL0101\x1bMNominal Size: {NominalSizeUs}
\x1bH145\x1bV0570\x1bL0101\x1bM{NominalSizeMetric}
\x1bH115\x1bV0020\x1bL0101\x1bMActual Size: {ActualSizeUs}
\x1bH115\x1bV0570\x1bL0101\x1bM{ActualSizeMetric}
\x1bH085\x1bV0020\x1bL0101\x1bMThickness: {Thickness}
\x1bH055\x1bV0020\x1bL0101\x1bMCoverage Area Per Carton: {SalesQtyFormatted} {SalesUom}{CoverageMetricFormatted}
\x1bH025\x1bV0020\x1bL0101\x1bMWeight Per Carton: {PackageWeightFormatted} LBS{PackageWeightMetricFormatted}
\x1bH085\x1bV0760\x1bB9030852B02C28{CartonBarcodeSerial}
\x1bQ{Quantity}
\x1bZ
