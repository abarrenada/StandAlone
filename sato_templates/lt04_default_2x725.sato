# symbolic SATO template
# family: F&D Private Label (label-type-code=4) / 2x7.25 / automatic (PLC)
# ported field-for-field from c:\Workspace\southalr\dtplb004.i, dispatched from dtplc067.p's
# ih-label-type-code=4 branch (~line 839) when the line's configured include for this size is
# "dtlbl060d.i".
#
# Simplifications (documented, not oversights):
# - No setsato table equivalent (same accepted gap as the rest of this port) -- heat/speed
#   hardcoded to the .i file's own defaults (#E2/CS3).
# - Source only builds this layout for S86R*/85R/85X* printer models, falling back to a literal
#   "NON SUPPORTED PRINTER STYLE" label for everything else -- none of this port's currently
#   cataloged models (M84Pro/M8485SE/S86NX/S86EX) match that raw device-model prefix check, so
#   always rendering the real content here (skipping the model gate) is more useful for testing
#   than defaulting every station to the unsupported-style label.
# - NominalSizeUs/Metric, ActualSizeUs/Metric, Thickness come from a SAP-fed sapitemhdr/
#   sapitemuom buffer in Progress (dtlbl007n.i) -- no equivalent exists in this port, so they
#   ship blank until a real SAP data source is wired up (see ThermalLabelPayload.cs).
# - "Box Quantity:" maps to LisQty (Progress prt-qty-carton, which in the common case just
#   equals id-lis-qty -- this port doesn't track the rarer quantity-override scenario that
#   would make them differ).
# - Legacy source ends with a literal "xxxxxxxxxx" (10 x's) after ETX in every F&D size --
#   reproduced verbatim rather than guessed at, same treatment as CrossOver's "~A0".

<STX>
\x1bA
\x1bCS3
\x1b#E2
\x1bA3H0000V0000
\x1b%3
\x1bH355\x1bV0020\x1bL0101\x1bRDA00,P16,P20,{ColorDesc}
\x1bH305\x1bV0950\x1bL0101\x1bRDA00,P16,P16,SKU# {CustomerPartNumber}
\x1bH295\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Box Quantity: {LisQty}
\x1bH260\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Lot Code: {ShadeLotCode}
\x1bH225\x1bV0020\x1bL0101\x1bRDA00,P12,P12,Production Date: {MfgDateCodeShort}
\x1bH265\x1bV0950\x1bD3021300{CartonUpcNumSys}{CartonUpcMfg}{CartonUpcProd}{CartonUpcChkdgt}
\x1bH130\x1bV0935\x1bL0102\x1bS{CartonUpcNumSys}
\x1bH130\x1bV0975\x1bL0102\x1bS{CartonUpcMfg}
\x1bH130\x1bV1060\x1bL0102\x1bS{CartonUpcProd}
\x1bH130\x1bV1145\x1bL0102\x1bS{CartonUpcChkdgt}
\x1bH185\x1bV0020\x1bL0101\x1bMNominal Size: {NominalSizeUs}
\x1bH185\x1bV0570\x1bL0101\x1bM{NominalSizeMetric}
\x1bH155\x1bV0020\x1bL0101\x1bMActual Size: {ActualSizeUs}
\x1bH155\x1bV0570\x1bL0101\x1bM{ActualSizeMetric}
\x1bH125\x1bV0020\x1bL0101\x1bMThickness: {Thickness}
\x1bH065\x1bV0760\x1bL0101\x1bMCoverage Area Per Carton: {SalesQtyFormatted} {SalesUom}{CoverageMetricFormatted}
\x1bH045\x1bV0760\x1bL0101\x1bMWeight Per Carton: {PackageWeightFormatted} LBS{PackageWeightMetricFormatted}
\x1bH085\x1bV0035\x1bB9030852B02C28{CartonBarcodeSerial}
\x1bQ{Quantity}
\x1bZ
<ETX>xxxxxxxxxx
