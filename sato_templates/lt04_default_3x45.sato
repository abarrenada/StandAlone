# symbolic SATO template
# family: F&D Private Label (label-type-code=4) / 3x4.5 / automatic (PLC), left-hand engine
# ported field-for-field from c:\Workspace\southalr\dtplb008.i, dispatched from dtplc067.p's
# ih-label-type-code=4 branch when the line's configured include for this size is "dtlbl065c.i".
#
# Source's model gate (84VL/M84*/S86*/8485*/85* = supported, else = "NON SUPPORTED PRINTER
# STYLE") covers every model this port currently catalogs (M84Pro, M8485SE, S86NX, S86EX all
# match), so the gate is skipped here -- always render the real content, matching the
# 2x725/1.75x8.38 templates' same simplification.
#
# {Fnd3x45Footer} is Progress's separate LabelVarB -- a per-model trailing STX...ETX block sent
# right after this one (S86 vs S84 vs other-85 vs 84-family each get a different positioning
# command; see ThermalPrinterCommandBuilder.ComputeFnd3x45Footer). Also carries its own literal
# "xxxxx" after the header's early ESC Z ETX, reproduced verbatim same as the other trailing-x
# sequences in this family.

<STX>
\x1bA
\x1bCS4
\x1b#E2
\x1bN
\x1bAR
\x1bZ
<ETX>xxxxx
<STX>
\x1bA
\x1bA109120608
\x1bA3H0000V0000
\x1b%1
\x1bH060\x1bV880\x1bL0101\x1bRDA00,P16,P20,{ColorDesc}
\x1bH120\x1bV350\x1bL0101\x1bRDA00,P16,P16,SKU# {CustomerPartNumber}
\x1bH125\x1bV880\x1bL0101\x1bRDA00,P12,P12,Box Quantity: {LisQty}
\x1bH160\x1bV880\x1bL0101\x1bRDA00,P12,P12,Lot Code: {ShadeLotCode}
\x1bH195\x1bV880\x1bL0101\x1bRDA00,P12,P12,Production Date: {MfgDateCodeShort}
\x1bH160\x1bV250\x1bD3021300{CartonUpcNumSys}{CartonUpcMfg}{CartonUpcProd}{CartonUpcChkdgt}
\x1bH295\x1bV265\x1bL0102\x1bS{CartonUpcNumSys}
\x1bH295\x1bV220\x1bL0102\x1bS{CartonUpcMfg}
\x1bH295\x1bV135\x1bL0102\x1bS{CartonUpcProd}
\x1bH295\x1bV045\x1bL0102\x1bS{CartonUpcChkdgt}
\x1bH240\x1bV880\x1bL0101\x1bMNominal Size: {NominalSizeUs}
\x1bH270\x1bV670\x1bL0101\x1bM{NominalSizeMetric}
